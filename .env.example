# Copia este archivo a .env (nunca subas .env a Git).

# --- Panel local y scripts (tu PC) ---
# Usuario dueño de la base, a través del túnel SSH (manual, sección 4.1).
ADMIN_DATABASE_URL=postgres://gk_owner:CONTRASEÑA@127.0.0.1:5433/gestor
ADMIN_PORT=4000
# Solo con Supabase (manual, sección 12): ruta ABSOLUTA al certificado del servidor.
# DATABASE_CA_FILE=D:\ruta\al\proyecto\secrets\supabase-ca.crt
# Contraseña del usuario gk_api. Si la dejas vacía, npm run db:roles genera una.
API_DB_PASSWORD=

# --- API (solo si la ejecutas en local para probar; en el servidor va en /etc/gestor-de-claves/api.env) ---
# DATABASE_URL=postgres://gk_api:CONTRASEÑA@127.0.0.1:5432/gestor
# Ruta ABSOLUTA (la API se ejecuta desde apps/api):
# SIGNING_PRIVATE_KEY_FILE=D:\ruta\al\proyecto\secrets\signing-private.pem
# SIGNING_KEY_ID=k-20261123
# TOKEN_TTL_DAYS=7
# ISSUER=gestor-de-claves
# HOST=127.0.0.1
# PORT=3000
# TRUSTED_IP_HEADER=
# DATABASE_POOL_MAX=10
